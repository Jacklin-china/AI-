# 复制为 .env 后填写（.env 已被 .gitignore 排除：绝不提交、绝不截图外发）
# 各平台控制台申请；泄露处理：立即在平台作废重发，并检查 git 历史是否有残留

# 火山方舟（主力：豆包 Seed 2.1 Turbo 文本 + 视觉）
# 这是 API Key，不能填到下方即梦 OpenAPI 的 AK/SK 中。
ARK_API_KEY=

# 阿里云百炼（Qwen 文本/视觉模型）
DASHSCOPE_API_KEY=

# 火山引擎即梦 OpenAPI（必须是 IAM 的 Access Key ID + Secret Access Key）
# 它与方舟 API Key、即梦客户端登录和会员积分都不是同一类凭据。
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

# 智谱开放平台（降级位 glm-4.6；主力不可用时自动切）
BIGMODEL_API_KEY=

# DeepSeek（用户授权的小额测试；真实值只允许放在项目根目录 .env）
DEEPSEEK_API_KEY=

# OpenAI（GPT-5.6 文本/视觉 + GPT-Image 生图）
OPENAI_API_KEY=
