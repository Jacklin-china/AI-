# 复制为 .env 后填写（.env 已被 .gitignore 排除：绝不提交、绝不截图外发）
# 各平台控制台申请；泄露处理：立即在平台作废重发，并检查 git 历史是否有残留

# DeepSeek（主力文本模型；配置由 settings.yaml 的 llm 段读取）
DEEPSEEK_API_KEY=

# 视觉质检（当前代码要求 OpenAI-compatible VLM；不是即梦 Visual API 的 AK/SK）
# 若使用 OpenAI 视觉质检，在此填写 OpenAI API Key。
OPENAI_API_KEY=

# 火山方舟（可选备用，不是当前主力）
# 这是 API Key，不能填到下方即梦 OpenAPI 的 AK/SK 中。
ARK_API_KEY=

# 阿里云百炼（Qwen 文本/视觉模型）
DASHSCOPE_API_KEY=

# 即梦 Visual API 只用于生图；需要 IAM Access Key ID + Secret Access Key。
# 它与方舟 API Key、即梦客户端登录和会员积分都不是同一类凭据。
# 真实值只允许放在项目根目录 .env，不能写入 YAML 或提交记录。
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

# 智谱开放平台（降级位 glm-4.6；主力不可用时自动切）
BIGMODEL_API_KEY=
