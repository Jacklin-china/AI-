# secrets & 本地配置（绝不提交）
.env
config/settings.yaml

# python
__pycache__/
*.py[cod]
.venv/
.uv-cache/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# frontend
node_modules/

# 运行时数据（SQLite/日志/下载）
# 必须带前导斜杠锚定根目录：不加斜杠的 `artifacts/` 会匹配任意层级，
# 曾把 frontend/src/components/artifacts/ 的源码一并忽略。
/data/
/logs/
/cache/
/artifacts/
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# 大体积演示视频（>10MB 不进 git，README 放链接）
assets/demo/*.mp4

# 生成用参考素材（人像/风格/场景样例，代码不引用）
assets/reference/

# os
.DS_Store
Thumbs.db

# IDE（PyCharm 本地配置，不进 git）
.idea/

# Unified managed transient storage
/tmp/

# 本地 agent 工作区（记忆、临时验证脚本与截图，不进 git）
.workbuddy/
